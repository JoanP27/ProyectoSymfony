{% extends 'layout.html.twig' %}
{% block main %}
    <main class="p-4">
        <section class="flex flex-col gap-4 mt-4">
            <form class="bg-white/7 p-4 rounded-md flex gap-4 items-center" action="{{ path('app_admin_index') }}" method="get">
                <select class="field" name="role" id="role">
                    <option value="">-- ninguno --</option>
                    <option {{ filtros['role'] == 'ROLE_USER' ? 'selected' : ''}} value="ROLE_USER">User</option>
                    <option {{ filtros['role'] == 'ROLE_ADMIN' ? 'selected' : ''}} value="ROLE_ADMIN">Admin</option>
                </select>
                <button type="submit" class="btn btn-blue">Filtrar</button>
            </form>
            {% for u in usuarios %}
                <section class="bg-white/10 p-4 rounded-md flex justify-between items-center">
                    <div class="flex items-center gap-8">
                        <img class="size-15 object-cover rounded-full" src="{{ u.avatar ? asset('uploads/avatars/' ~ u.avatar) : asset('imgs/placeholder.jpg') }}">
                        <p>{{ u.nombre }}</p>
                        <p>{{ u.email }}</p>
                    </div>
                    <div class="flex gap-2">
                        {% if u.id != app.user.id %}
                        <form action="{{ path('app_admin_changerole', {'id': u.id}) }}" method="post">
                            <input type="hidden" name="role" id="role" value="{{ "ROLE_ADMIN" in u.roles ? "ROLE_USER" : "ROLE_ADMIN" }}">
                            <button type="submit" class="btn btn-blue">Hacer {{ "ROLE_ADMIN" in u.roles ? "User" : "Admin"  }}</button>
                        </form>
                        <form action="{{ path('app_admin_delete', {'id': u.id}) }}" method="post">
                            <button type="submit" class="btn btn-red"> Eliminar </button>
                        </form>
                        {% endif %}
                    </div>
                </section>
            {% endfor %}
        </section>
    </main>
{% endblock %}
