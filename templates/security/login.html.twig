{% extends 'layout.html.twig' %}
{% block main %}
    <section class="w-full h-130 flex justify-center items-center">
        <section class="w-100 bg-white/7 p-4 px-6 rounded-md">
            <form method="post" class="flex flex-col items-center gap-10">
                <h1 class="text-xl">Iniciar sesion</h1>
                <section class="w-full flex flex-col gap-5">
                    <div>
                        <p>Email: </p>
                        <input
                            class="field w-full"
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            autocomplete="email"
                            required autofocus
                        >
                    </div>

                    <div>
                        <p>Contraseña:</p>
                        <input
                            class="field w-full"
                            type="password"
                            name="_password"
                            id="password"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                </section>
                <input
                    type="hidden"
                    name="_csrf_token"
                    data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}"
                >
                <button class="btn btn-blue w-30" type="submit">
                    Sign in
                </button>
            </form>
        </section>
    </section>
{% endblock %}

