<header class="bg-white/5 flex flex-row p-6 items-center justify-between">
    <section id="logo" class="flex flex row items-center gap-2">
        <img class="w-20 item-cover" src="{{ asset('imgs/logo.png') }}" alt="">
        <h3 class="text-2xl">DevCave</h3>
    </section>
    <nav class="flex flex-row">
        <a class="menu-item" href="{{ path('app_juego_index') }}">Inicio</a>
        <a class="menu-item">Mis publicaciones</a>
        <a class="menu-item" href="{{ path('app_juego_library') }}">Mi Biblioteca</a>
        <a class="menu-item" href="{{ path('app_juego_new') }}">Nuevo Juego</a>
        <a class="menu-item">Panel de control</a>
    </nav>
    <section id="login">
        {% if app.user %}
            <a class="btn-logout" href="/logout">Cerrar sesión</a>
        {% else %}
            <a class="btn-login" href="{{ path('app_login') }}">Iniciar sesion</a>
        {% endif %}
    </section>
</header>
