{% extends 'layout.html.twig' %}
{% block main %}
    {% if(app.user.id == juego.autor.id) %}
        <section class="p-4">
            <section class="bg-white/10 flex p-4 rounded-md gap-2 ">
                <a href="{{ path('app_juego_edit', {'id': juego.id}) }}" class="w-20 text-center btn btn-blue">Editar</a>
                <form method="post" action="{{ path('app_juego_delete', {'id': juego.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ juego.id) }}">
                    <button class="w-20 text-center btn btn-red" type="submit">Eliminar</button>
                </form>
            </section>
        </section>
    {% endif %}
    <main class="p-4 flex flex-col gap-4 items-stretch">
        <section class=" flex flex-col gap-8">
            <section>
                <img class="w-full h-80 object-cover" src="{{ juego.rutaImagen ? asset('uploads/img_juegos/' ~ juego.rutaImagen) : asset('imgs/placeholder.jpg') }}" alt="">
            </section>
            <section class="flex flex-col gap-2">
                <h2 class="text-2xl mb-2">{{ juego.titulo }}</h2>
                <p>{{ juego.descripcion }}</p>
            </section>
            {% if juego.categoria %}
            <section>
                <h2 class="text-xl mb-2">Categoria</h2>
                <section class="flex">
                    <span class="tag-green">{{ juego.categoria.nombre }}</span>
                </section>
            </section>
            {% endif %}
            <form method="post" action="{{ path('app_juego_buy', {"id": juego.id}) }}" class="bg-white/10 flex justify-between p-4 items-center rounded-xl">
                <h3 class="text-xl">Comprar Juego</h3>
                <input type="hidden" name="_token" value="{{ csrf_token('buy' ~ juego.id) }}">
                <button {{ app.user.id == juego.autor.id ? 'disabled' : '' }} type="submit" class="w-20 text-center btn {{ app.user.id == juego.autor.id ? 'btn-disabled' : 'btn-blue' }}">{{ juego.precio }} €</button>
            </form>
        </section>
        <h2 class="text-xl">Creador</h2>
        <section class="h-auto flex-1 bg-white/10 p-4 rounded-md">
            <section class="flex items-center gap-5 p-2">
                <div>
                    <img  class="rounded-full object-cover size-20" src="{{ app.user.avatar ? asset('uploads/avatars/' ~ app.user.avatar) : asset('imgs/placeholder.jpg') }}">
                </div>
                <h2 class="text-xl"><a href="{{ path('app_profile', {'id': juego.autor.id}) }}">{{ juego.autor.nombre }}</a></h2>
            </section>
        </section>
        <section>
            <h3 class="text-xl">Comentarios</h3>
            <section class="flex flex-col gap-2 mb-4">
                {% for c in juego.comentarios %}
                    <section class="p-4 bg-white/10 rounded-md">
                        <section class="flex items-center gap-4 mb-2">
                            <img class="rounded-full object-cover size-10" src="{{ c.emisor.avatar ? asset('uploads/avatars/' ~ c.emisor.avatar) : asset('imgs/placeholder.jpg') }}">
                            {{ c.emisor.nombre }}
                        </section>

                        <p class="border-t pt-2 border-white/20">{{ c.mensaje }}</p>
                    </section>
                {% endfor %}
            </section>
            {{ form_start(commentarioForm) }}
            <section class="flex flex-col gap-2 p-4 bg-white/7 rounded-md">
                    {{ form_widget(commentarioForm.mensaje) }}
                    <div>
                        <button type="submit" class="btn btn-blue">Enviar</button>
                    </div>
            </section>
            {{ form_end(commentarioForm) }}
        </section>
    </main>
{% endblock %}
