{% extends 'layout.html.twig' %}
{% block main %}
    {% if(app.user.id == juego.autor.id) %}
        <section class="p-4">
            <section class="bg-white/10 flex p-4 rounded-md gap-2">
                <a href="{{ path('app_juego_edit', {'id': juego.id}) }}" class="w-20 text-center btn btn-blue">Editar</a>
                <form method="post" action="{{ path('app_juego_delete', {'id': juego.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ juego.id) }}">
                    <button class="w-20 text-center btn btn-red" type="submit">Eliminar</button>
                </form>
            </section>
        </section>
    {% endif %}
    <main class="p-4 flex gap-4 items-stretch">
        <section class="w-4/5 flex flex-col gap-8">
            <section>
                <img class="w-full h-80 object-cover" src="{{ asset('imgs/placeholder.jpg') }}" alt="">
            </section>
            <section class="flex flex-col gap-2">
                <h2 class="text-2xl mb-2">{{ juego.titulo }}</h2>
                <p>{{ juego.descripcion }}</p>
            </section>
            <form method="post" action="{{ path('app_juego_buy', {"id": juego.id}) }}" class="bg-white/10 flex justify-between p-4 items-center rounded-xl">
                <h3 class="text-xl">Comprar Juego</h3>
                <input type="hidden" name="_token" value="{{ csrf_token('buy' ~ juego.id) }}">
                <button {{ app.user.id == juego.autor.id ? "disabled" : "" }} type="submit" class="w-20 text-center btn btn-disabled not-disabled:btn-blue">{{ juego.precio }} €</button>
            </form>
        </section>
        <section class="h-auto flex-1 w-1/5 bg-white/10 p-4 rounded-md">
            <section class="flex items-center gap-5 border-b border-white/20 p-2 pb-4">
                <div>
                    <img  class="rounded-full size-30" src="{{ asset('imgs/placeholder.jpg') }}">
                </div>
                <h2 class="text-xl">{{ juego.autor.nombre }}</h2>
            </section>
        </section>
    </main>
{% endblock %}
