{% extends 'base.html.twig' %}

{% block title %}Juego{% endblock %}

{% block body %}
    <h1>Juego</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ juego.id }}</td>
            </tr>
            <tr>
                <th>Titulo</th>
                <td>{{ juego.titulo }}</td>
            </tr>
            <tr>
                <th>Descripcion</th>
                <td>{{ juego.descripcion }}</td>
            </tr>
            <tr>
                <th>Precio</th>
                <td>{{ juego.precio }}</td>
            </tr>
            <tr>
                <th>Fecha</th>
                <td>{{ juego.fecha ? juego.fecha|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>RutaImagen</th>
                <td>{{ juego.rutaImagen }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_juego_index') }}">back to list</a>

    <a href="{{ path('app_juego_edit', {'id': juego.id}) }}">edit</a>

    {{ include('juego/_delete_form.html.twig') }}
{% endblock %}
