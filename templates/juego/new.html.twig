{% extends 'layout.html.twig' %}
{% block main %}
    <main class="p-4">
        {{ form_start(form) }}
        <section class="bg-white/10 flex p-4 rounded-md gap-2 mb-4">
            <button type="submit" class="w-20 text-center btn btn-blue">Guardar</button>
            <a href="{{ path('app_juego_index') }}" class="w-20 text-center btn btn-gray">Cancelar</a>
        </section>
        <section class="flex flex-col gap-4 bg-white/7 p-4 rounded-md">
            <div class="flex flex-col gap-1">
                {{ form_label(form.titulo) }}
                {{ form_widget(form.titulo) }}
            </div>
            <div class="flex flex-col gap-1">
                {{ form_label(form.descripcion) }}
                {{ form_widget(form.descripcion) }}
            </div>
            <div class="flex flex-col gap-1">
                {{ form_label(form.precio) }}
                {{ form_widget(form.precio) }}
            </div>
            <div class="flex flex-col gap-1">
                {{ form_label(form.fecha) }}
                {{ form_widget(form.fecha) }}
            </div>
            <div class="flex mt-4 gap-1">
                {{ form_label(form.rutaImagen) }}
                {{ form_widget(form.rutaImagen) }}
            </div>
        </section>
        {{ form_end(form) }}
    </main>
{% endblock %}
