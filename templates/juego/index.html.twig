{% extends 'layout.html.twig' %}
{% block main %}
    <main class="p-4">
        {% block search %}
            <section class="flex p-5 rounded-xl bg-white/7 border border-white/20 items-center mb-5">
                <form action="{{ path('app_juego_index') }}" method="get" style="display: flex; gap: 0.5em">
                    <label for="titulo" class="hidden">Buscar</label>
                    <input class="field" type="text" name="titulo" id="titulo" placeholder="Buscar" value="{{ filtros['titulo'] }}">

                    <label for="categoria"></label>
                    <select class="field" name="categoria" id="categoria">
                        <option value="0"> -- Ninguna -- </option>
                        {% for c in categorias %}
                            <option {{ filtros['categoria'] == c.id ? 'selected' : '' }} value="{{ c.id }}">{{ c.nombre }}</option>
                        {% endfor %}
                    </select>

                    <label for="fecha_inicio"></label>
                    <input class="field" type="date" name="fecha_inicio" id="fecha_inicio" value="{{filtros['fechaInicio'] ? filtros['fechaInicio'] | date('Y-m-d') : '' }}">

                    <label for="fecha_final"></label>
                    <input class="field" type="date" name="fecha_final" id="fecha_final" value="{{filtros['fechaFinal'] ? filtros['fechaFinal'] | date('Y-m-d') : '' }}"/>

                    <button class="btn btn-blue" type="submit">Buscar</button>
                    <button class="btn btn-gray" type="reset">Limpiar filtros</button>
                </form>
            </section>
        {% endblock %}
        {% block result %}
            <section class="flex gap-4 flex-wrap">
                {% for juego in juegos %}
                    {% include 'partials/juego.html.twig' %}
                {% endfor %}
            </section>
        {% endblock %}
    </main>
{% endblock %}
